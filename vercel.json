{
  "functions": {
    "server.js": {
      "includeFiles": "{public/**,data/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/server.js?path=:path*"
    },
    {
      "source": "/(overview|products|sessions|reports|profile|feedback|admin|settings)",
      "destination": "/index.html"
    }
  ]
}
